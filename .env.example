# RefConcept — docker compose host-side configuration.
# Copy to .env (repo root). Host ports are intentionally non-default so the stack
# never collides with a local XAMPP/Apache/MySQL installation.

COMPOSE_PROJECT_NAME=refconcept

DB_DATABASE=refconcept
DB_USERNAME=refconcept
DB_PASSWORD=refconcept
DB_PORT_HOST=55432

REDIS_PORT_HOST=56379

AWS_ACCESS_KEY_ID=refconcept
AWS_SECRET_ACCESS_KEY=refconcept-secret
AWS_BUCKET=refconcept-private
AWS_PUBLIC_BUCKET=refconcept-public
MINIO_PORT_HOST=59000
MINIO_CONSOLE_PORT_HOST=59001

MAIL_PORT_HOST=51025
MAIL_UI_PORT_HOST=58025

API_PORT_HOST=58000

STOREFRONT_PORT=3000
SELLER_PORTAL_PORT=3001
ADMIN_PANEL_PORT=3002
