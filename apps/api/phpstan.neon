includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app
        - config
        - database
        - routes
        - tests

    excludePaths:
        - vendor
        - bootstrap/cache

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Pest binds `$this` inside test closures to the configured TestCase at runtime.
        # Static analysis sees Pest\PendingCalls\TestCall instead, so framework assertion
        # helpers ($this->getJson(), ...) and per-test properties set in beforeEach
        # ($this->sellerA) both read as undefined. Scoped strictly to test directories so
        # production code keeps every check.
        #
        # reportUnmatched is off because test directories come and go as phases land; an
        # unmatched entry here is expected, not a misconfiguration.
        -
            identifier: method.notFound
            reportUnmatched: false
            paths:
                - tests/*
                - app/Domains/*/Tests/*
        -
            identifier: property.notFound
            reportUnmatched: false
            paths:
                - tests/*
                - app/Domains/*/Tests/*
        -
            identifier: argument.templateType
            reportUnmatched: false
            paths:
                - tests/*
                - app/Domains/*/Tests/*
