###############################################################################
# RefConcept API
# Copy to .env. Never commit real credentials; production secrets live in the
# deployment secret store (16_ENVIRONMENT_DEVOPS_RELEASE.md).
###############################################################################

APP_NAME=RefConcept
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:58000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

REFCONCEPT_VERSION=0.1.0-phase0
REFCONCEPT_MILESTONE=WEB
REFCONCEPT_DEFAULT_CURRENCY=TRY
REFCONCEPT_STOREFRONT_URL=http://localhost:3000
REFCONCEPT_SELLER_PORTAL_URL=http://localhost:3001
REFCONCEPT_ADMIN_PANEL_URL=http://localhost:3002

# --- logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- database (PostgreSQL; hostnames resolve inside the docker network) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=refconcept
DB_USERNAME=refconcept
DB_PASSWORD=refconcept

# --- cache / session / queue (Redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- object storage (MinIO locally, S3-compatible in production) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=refconcept
AWS_SECRET_ACCESS_KEY=refconcept-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=refconcept-private
AWS_PUBLIC_BUCKET=refconcept-public
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:59000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- mail (Mailpit locally) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@refconcept.local
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# External integrations
# Placeholders only. Real sandbox/production credentials are external go-live
# dependencies tracked in 13_PROGRESS_STATE.md.
###############################################################################

# --- AI providers (model IDs are configured in the database, never hard-coded) ---
AI_DEFAULT_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_AI_API_KEY=

# --- payments ---
PAYMENT_DEFAULT_GATEWAY=fake

IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

QNB_ENABLED=false
QNB_MERCHANT_ID=
QNB_TERMINAL_ID=
QNB_API_KEY=
QNB_SECRET_KEY=
QNB_BASE_URL=

BANK_TRANSFER_ENABLED=true
